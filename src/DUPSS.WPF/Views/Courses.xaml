<Page x:Class="DUPSS.WPF.Views.Courses"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Courses" Height="580">

    <Page.Resources>
        <!-- Converter for placeholder visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="White">
        <StackPanel Margin="40" HorizontalAlignment="Center" Width="800">
            <TextBlock Text="Our Most Popular Courses"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="The sky was cloudless and of a deep dark blue the spectacle before us was indeed."
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>

            <!-- Search Box -->
            <Grid Width="400" Height="32" Margin="0,0,0,20">
                <TextBox x:Name="SearchBox"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         Padding="5,0,0,0"/>
                <TextBlock Text="Search courses by name or topic..."
                           Foreground="Gray"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Loading/Error/No Results -->
            <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock x:Name="StatusText" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                <!-- You can add a ProgressBar or Spinner here if needed -->
            </StackPanel>

            <!-- Courses Grid -->
            <ItemsControl x:Name="CoursesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="240" ItemHeight="320"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Padding="10" Background="#F7F7F7" CornerRadius="8" Width="220" Height="300" Cursor="Hand"
                                MouseLeftButtonUp="CourseCard_Click">
                            <StackPanel>
                                <Image Source="{Binding ImageUrl, TargetNullValue='https://placehold.co/300x200/F0F0F0/000000?text=Course+Image'}"
       Height="120" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Topic.TopicName, TargetNullValue=General}" Foreground="#1e68ff" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding CourseName}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Type: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CourseType}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Explore More / Show Less Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ExploreMoreButton" Content="Explore More" Click="ExploreMoreButton_Click" Visibility="Collapsed" Margin="5"/>
                <Button x:Name="ShowLessButton" Content="Show Less" Click="ShowLessButton_Click" Visibility="Collapsed" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>