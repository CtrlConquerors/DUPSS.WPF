<Page x:Class="DUPSS.WPF.Views.Courses"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Courses" Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <!-- Wrap the main content with a ScrollViewer -->
    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Height="639">
        <StackPanel Margin="50" HorizontalAlignment="Center" Width="800">

            <!-- Tiêu đề -->
            <TextBlock Text="Our Most Popular Courses"
                       FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="The sky was cloudless and of a deep dark blue the spectacle before us was indeed."
                       FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <!-- Search Box -->
            <Grid Width="400" Height="32" Margin="0,0,0,20">
                <TextBox x:Name="SearchBox"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         Padding="8,0,0,0"/>
                <TextBlock Text="Search courses by name or topic..."
                           Foreground="Gray" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Status -->
            <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock x:Name="StatusText" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Courses Grid -->
            <ItemsControl x:Name="CoursesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Padding="10" Background="#F7F7F7" CornerRadius="8" Width="220" Height="300"
                                Cursor="Hand" MouseLeftButtonUp="CourseCard_Click">
                            <StackPanel>
                                <Image Height="180" Stretch="UniformToFill" Margin="0,0,0,10">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding ImageUrl}" />
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="{Binding Topic.TopicName}" Foreground="#1e68ff" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding CourseName}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Type: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CourseType}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ExploreMoreButton" Content="Explore More"
            Click="ExploreMoreButton_Click" Visibility="Collapsed" Margin="5"
            Background="#1e68ff"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="16"
            Padding="18,8"
            BorderThickness="0"
            Width="110"
            Height="30"            
            Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1554c0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#e0e0e0"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ShowLessButton" Content="Show Less"
            Click="ShowLessButton_Click" Visibility="Collapsed" Margin="5"
            Background="#1e68ff"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="16"
            Padding="18,8"
            BorderThickness="0"
            Width="110"
            Height="30"              
            Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1554c0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#e0e0e0"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
