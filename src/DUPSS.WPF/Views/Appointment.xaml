<Page x:Class="DUPSS.WPF.Views.Appointment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Appointments"
      Background="#F7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" >

            <!-- Header -->
            <TextBlock Text="My Appointments"
                       FontFamily="Montserrat"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1e68ff"
                       Margin="0,0,0,25"/>

            <!-- Filter Card -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,25"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >

                    <TextBox x:Name="SearchBox" Width="180" Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             Height="34" Padding="6"
                             Background="#F0F2F5"
                             BorderThickness="0"
                             FontSize="13"
                             Foreground="Gray"
                             Text="Find by consultant"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>

                    <DatePicker x:Name="FromDatePicker" Width="140" Height="34" Margin="0,0,10,0"/>
                    <DatePicker x:Name="ToDatePicker" Width="140" Height="34" Margin="0,0,10,0"/>

                    <ComboBox x:Name="StatusComboBox" Width="140" Height="34" Margin="0,0,10,0">
                        <ComboBoxItem Content="-- Status --" IsSelected="True"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Accepted"/>
                        <ComboBoxItem Content="Declined"/>
                        <ComboBoxItem Content="Finished"/>
                        <ComboBoxItem Content="Cancel"/>
                        <ComboBoxItem Content="Missed"/>
                    </ComboBox>

                    <Button Content="Filter" Width="80" Height="34" Margin="0,0,5,0"
                            Background="#1e68ff" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand"
                            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
                            Click="FilterButton_Click"/>

                    <Button Content="Reset" Width="80" Height="34"
                            Background="#fdd835" Foreground="Black" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand"
                            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </Border>

            <!-- DataGrid Card -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="10"
                    Effect="{DynamicResource CardShadow}">
                <DataGrid x:Name="AppointmentDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowBackground="White"
                          AlternatingRowBackground="#f5f8fe"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          ColumnHeaderHeight="38"
                          RowHeight="38"
                          FontSize="13"
                          VerticalGridLinesBrush="#e0e0e0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1e68ff" Offset="0"/>
                                        <GradientStop Color="#397cfb" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                    <Setter Property="Background" Value="#FFF9C4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}" Width="2*"/>
                        <DataGridTextColumn Header="Consultant" Binding="{Binding ConsultantUsername}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                            <Setter Property="Foreground" Value="Orange"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Declined">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancel">
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="2*"/>
                        <DataGridTemplateColumn Header="Action" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="❌ Cancel"
                                                ToolTip="Cancel this appointment"
                                                Foreground="Red" Background="Transparent"
                                                BorderThickness="0" FontWeight="SemiBold"
                                                Visibility="{Binding CancelVisibility}"
                                                Cursor="Hand"
                                                Click="CancelButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
