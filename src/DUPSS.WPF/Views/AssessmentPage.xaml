<Page x:Class="DUPSS.WPF.Views.AssessmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      mc:Ignorable="d" 
      Title="Assessment Page"
      Background="#F0F4FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="20" Background="White" Margin="20" MaxWidth="850" HorizontalAlignment="Center" CornerRadius="10">
            <StackPanel>
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock Text="🧠" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Mental Health &amp; Substance Use Assessments" FontSize="28" FontWeight="Bold" 
                               Foreground="#3554d1" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Complete validated screening tools to assess your mental health and substance use patterns."
                               FontSize="16" Foreground="#3554d1" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Assessment List -->
                <StackPanel x:Name="AssessmentContainer">
                    <ContentControl x:Name="AssessmentContent">
                        <!-- Loading State -->
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Loading assessments..." FontSize="16" Margin="0,0,0,10"/>
                                            <ProgressBar IsIndeterminate="True" Width="100" Height="10"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="Oops! Something went wrong while loading assessments. Please try again later."
                                                               FontSize="16" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Content="Retry" Width="100" Click="RetryLoadAssessments_Click"
                                                            Background="#3554d1" Foreground="White" Padding="10,5"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Assessments.Count}" Value="0">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <TextBlock Text="No assessments available at the moment. Please check back later!"
                                                           FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Assessments.Count}" Value="{x:Static Member=local:AssessmentPage.NonZero}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <ItemsControl ItemsSource="{Binding DisplayAssessments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#f5f8ff" Padding="15" Margin="10" CornerRadius="8" BorderBrush="#3554d122" BorderThickness="1" Width="300">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                        <TextBlock Text="{Binding AssessmentType}" FontWeight="Bold" FontSize="18" Foreground="#3554d1"/>
                                                                        <TextBlock Text="{Binding Version}" FontSize="14" Foreground="#666" Margin="10,0,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding DescriptionDisplay}" TextWrapping="Wrap" Margin="0,0,0,10" MaxHeight="80"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                        <TextBlock Text="{Binding LanguageDisplay}" FontSize="12" Foreground="#555" Margin="0,0,10,0"/>
                                                                        <TextBlock Text="{Binding EstimatedDuration}" FontSize="12" Foreground="#555"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Content="Take Assessment" Width="120" Margin="0,0,10,0" Click="StartAssessment_Click"
                                                                                Background="#3554d1" Foreground="White" Padding="10,5"/>
                                                                        <Button Content="Learn More" Width="120" Click="ViewAssessmentInfo_Click"
                                                                                Background="#e5e7eb" Foreground="#3554d1" Padding="10,5"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                    <!-- Show More/Less Button -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="ToggleButton" Content="{Binding ToggleButtonText}" Width="200" Click="ToggleShowAllAssessments_Click"
                                Background="#3554d1" Foreground="White" Padding="10,5" Visibility="{Binding ToggleButtonVisibility}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Info Section -->
                <GroupBox Header="💡 About These Assessments" Margin="0,20,0,0" FontWeight="Bold" Foreground="#3554d1">
                    <StackPanel Margin="10,5">
                        <Border Background="#f5f8ff" Padding="10" Margin="5" CornerRadius="8" BorderBrush="#3554d122" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CRAFFT Screening" FontWeight="Bold" FontSize="16" Foreground="#3554d1"/>
                                <TextBlock Text="A validated tool for screening adolescents and young adults for substance use disorders. Takes about 2-3 minutes."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#f5f8ff" Padding="10" Margin="5" CornerRadius="8" BorderBrush="#3554d122" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ASSIST Screening" FontWeight="Bold" FontSize="16" Foreground="#3554d1"/>
                                <TextBlock Text="WHO's Alcohol, Smoking and Substance Involvement Screening Test. Comprehensive assessment taking 5-10 minutes."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#f5f8ff" Padding="10" Margin="5" CornerRadius="8" BorderBrush="#3554d122" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Privacy &amp; Confidentiality" FontWeight="Bold" FontSize="16" Foreground="#3554d1"/>
                                <TextBlock Text="Your responses are confidential and used to provide personalized recommendations for your wellbeing."
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>