<Page x:Class="DUPSS.WPF.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Login">
    <Page.Resources>
        <!-- Storyboard for Popup Fade In Animation -->
        <Storyboard x:Key="PopupFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.92" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Storyboard for Logo Hover Animation -->
        <Storyboard x:Key="LogoHoverAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-2" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Note: Box shadow and filter effects are complex in WPF and often require custom shaders or BitmapEffect.
                 For simplicity, we'll omit direct translation of box-shadow and filter from CSS here. -->
        </Storyboard>
        <Storyboard x:Key="LogoNormalAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.22"/>
        </Storyboard>

        <!-- Style for form-control inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- Set CornerRadius directly on the Border -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <!-- REMOVED: <Setter Property="CornerRadius" Value="6"/> -->
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- Set CornerRadius directly on the Border -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for login button -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Blue"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <!-- REMOVED: <Setter Property="CornerRadius" Value="6"/> This is the problematic line -->
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="6" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e6e6ff"/>
                                <Setter Property="Foreground" Value="#0033cc"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Hyperlinks in footer -->
        <Style x:Key="FooterHyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#22c55e"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <!-- WPF doesn't have direct text-shadow. Transform is also complex here -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Footer2HyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="LightCoral"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#ff9800"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <!-- WPF doesn't have direct text-shadow. Transform is also complex here -->
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid>
        <!-- Background image -->
        <Image Source="/images/Others/login-background.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Login Container - Centers the card -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Login Card -->
            <Border Width="400" Padding="32" CornerRadius="8" Background="Transparent">
                <StackPanel>
                    <!-- Login Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0 0 0 24">
                        <Image Source="/images/Others/logo2.png" AutomationProperties.Name="ALPHA Logo" Width="130" Height="120" Margin="0 0 0 16"
                               RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <RotateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard Storyboard="{StaticResource LogoHoverAnimation}"/>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard Storyboard="{StaticResource LogoNormalAnimation}"/>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                        <TextBlock Text="ALPHA Login" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Login Form -->
                    <StackPanel Margin="0 0 0 16">
                        <StackPanel Margin="0 0 0 16">
                            <Label Content="Email" Foreground="White" HorizontalAlignment="Left" Margin="0 0 0 4"/>
                            <TextBox x:Name="EmailTextBox" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource {x:Type TextBox}}"
                                    />
                        </StackPanel>
                        <StackPanel Margin="0 0 0 16">
                            <Label Content="Password" Foreground="White" HorizontalAlignment="Left" Margin="0 0 0 4"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource {x:Type PasswordBox}}"
                                   />
                        </StackPanel>

                        <!-- Error Message -->
                        <Border x:Name="ErrorMessageBorder" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="Red" BorderBrush="Red" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0 16 0 0">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Success Message Popup -->
                        <Border x:Name="SuccessPopupBoard" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#22c55e" BorderBrush="#22c55e" BorderThickness="1.5" CornerRadius="32"
                                Padding="36 32 28 32" MinWidth="320" MaxWidth="400" Margin="0 16 0 0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0 0 0 12" HorizontalAlignment="Center"/>
                                <TextBlock Text="Redirecting to home page..." Foreground="White" FontSize="16" Margin="0 0 0 18" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Forgot Password Link -->
                        <TextBlock HorizontalAlignment="Right" Margin="0 0 0 16">
                            <Hyperlink NavigateUri="/forgot-password" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource FooterHyperlinkStyle}">
                                Forgot password?
                            </Hyperlink>
                        </TextBlock>

                        <!-- Login Button -->
                        <Button Content="Login" Click="LoginButton_Click" Style="{StaticResource LoginButtonStyle}"/>
                    </StackPanel>

                    <!-- Sign Up Link -->
                    <TextBlock HorizontalAlignment="Center" Margin="0 16 0 0">
                        <Run Text="Not a member? " Foreground="White"/>
                        <Hyperlink NavigateUri="/register" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource Footer2HyperlinkStyle}">
                            Sign up now
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
