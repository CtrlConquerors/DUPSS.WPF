<Page x:Class="DUPSS.WPF.Views.BlogDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Blog Detail"
      Background="#F4F4F4">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <!-- Accent color for news style -->
        <SolidColorBrush x:Key="AccentBrush" Color="#D7263D"/>
        <SolidColorBrush x:Key="MetaBrush" Color="#555"/>
        <Style x:Key="NewsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="NewsMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MetaBrush}"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NewsSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <Style x:Key="NewsButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading State -->
        <Border Background="#AAFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                CornerRadius="8" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading blog details..." FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#444"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="10" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <!-- Error State -->
        <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="8"
                Padding="30" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Oops! Could not load blog details. The blog may not exist or there was a server error."
                           TextWrapping="Wrap" FontSize="16" Foreground="#B71C1C" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Retry" Click="RetryLoadBlog_Click" Style="{StaticResource NewsButton}"/>
                    <Button Content="Back to Blogs" Click="GoBack_Click" Style="{StaticResource NewsButton}" Background="#888"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Not Found State -->
        <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="8"
                Padding="30" Visibility="{Binding NoBlogFound, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Blog not found." FontSize="16" Foreground="#B71C1C" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Back to Blogs" Click="GoBack_Click" Style="{StaticResource NewsButton}" Background="#888"/>
            </StackPanel>
        </Border>

        <!-- Blog Detail State -->
        <ScrollViewer Visibility="{Binding ShowBlogContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto">
            <!-- Replace this line (remove Effect property from Border) -->
            <Border Margin="0,30" Padding="0" Background="White" CornerRadius="10">
            
                <StackPanel>
                    <!-- Blog Hero Image -->
                    <Border Height="320" Background="#E0E0E0" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Image Source="{Binding Blog.ImageUrl}" 
                               Stretch="UniformToFill" 
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>

                    <!-- Blog Title and Meta -->
                    <StackPanel Margin="40,30,40,0">
                        <TextBlock Text="{Binding Blog.Title}" Style="{StaticResource NewsTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Topic: " Style="{StaticResource NewsMeta}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Blog.BlogTopic.BlogTopicName}" Style="{StaticResource NewsMeta}"/>
                            <TextBlock Text="Author: " Style="{StaticResource NewsMeta}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Blog.Staff.Username, TargetNullValue=Unknown}" Style="{StaticResource NewsMeta}"/>
                        </StackPanel>
                        <Separator Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Blog Content (Markdown as plain text for now) -->
                    <StackPanel Margin="40,0,40,0">
                        <TextBlock Text="Article" Style="{StaticResource NewsSectionHeader}"/>
                        <Border Padding="18" Background="#FAFAFA" CornerRadius="6" BorderBrush="#EEE" BorderThickness="1">
                            <FlowDocumentScrollViewer x:Name="BlogContentDocument"
                                                     VerticalScrollBarVisibility="Hidden"
                                                     IsToolBarVisible="False"
                                                     Foreground="#222"
                                                     FontSize="17"
                                                     Padding="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,30,0,30">
                        <Button Content="Back to Blogs" Click="GoBack_Click" Style="{StaticResource NewsButton}" Background="#888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>