<Page x:Class="DUPSS.WPF.Views.Blog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      mc:Ignorable="d"
      Title="Blog">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:TruncateConverter x:Key="TruncateConverter"/>
    </Page.Resources>

    <Grid Background="#f7f9fc">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40" HorizontalAlignment="Center" Width="1000">
                <TextBlock Text="Ongoing Blog Posts"
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"
                           Foreground="LightBlue"/>
                <TextBlock Text="Discover insights and updates from our team."
                           FontSize="16"
                           Foreground="Gray"
                           Margin="0,0,0,30"
                           HorizontalAlignment="Center"/>

                <!-- Filters -->
                <Border Background="#f8fafc" CornerRadius="18" Padding="18" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="350"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,18,0"
                                 Padding="8,0,0,0"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Search blogs by title, topic, or content..."/>
                        <ComboBox x:Name="TopicFilter"
                                  Width="220"
                                  Height="32"
                                  Margin="0,0,0,0"
                                  SelectionChanged="TopicFilter_SelectionChanged"
                                  DisplayMemberPath="BlogTopicName"
                                  SelectedValuePath="BlogTopicId"
                                  />
                    </StackPanel>
                </Border>

                <!-- Loading/Error/No Results -->
                <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock x:Name="StatusText" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Blog Grid -->
                <ItemsControl x:Name="BlogGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="320" ItemHeight="340"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" Padding="10" Background="#fff" CornerRadius="15" Width="300" Height="320" Cursor="Hand"
                                    MouseLeftButtonUp="BlogCard_Click">
                                <StackPanel>
                                    <!-- Image Source now expects a local pack URI or the common placeholder -->
                                    <Image Source="{Binding ImageUrl, TargetNullValue='pack://application:,,,/DUPSS.WPF;component/Images/Blogs/placeholder.png'}"
                                           Height="120" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0" Foreground="#2c3e50"/>
                                    <TextBlock Text="Topic: " FontWeight="SemiBold" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding BlogTopic.BlogTopicName, TargetNullValue='-'}" FontSize="12" Foreground="#888"/>
                                    <TextBlock Text="{Binding Content, Converter={StaticResource TruncateConverter}, ConverterParameter=100}" FontSize="13" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Explore More / Show Less Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="ExploreMoreButton" Content="Explore More"
            Click="ExploreMoreButton_Click" Visibility="Collapsed" Margin="5"
            Background="#1e68ff"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="16"
            Padding="8,8"
            BorderThickness="0"
            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1554c0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#e0e0e0"/>
                                        <Setter Property="Foreground" Value="#888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ShowLessButton" Content="Show Less"
            Click="ShowLessButton_Click" Visibility="Collapsed" Margin="5"
            Background="#1e68ff"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="16"
            Padding="8,8"
            BorderThickness="0"
            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1554c0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#e0e0e0"/>
                                        <Setter Property="Foreground" Value="#888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
