<Page x:Class="DUPSS.WPF.Views.AppointmentForConsultant"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AppointmentForConsultant"
      Background="#F7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <TextBlock Text="My Appointments"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1e68ff"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- Filter Panel -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBox Width="200" Margin="5" x:Name="SearchTextBox" ToolTip="Search by member or topic"
                         VerticalContentAlignment="Center" Height="30" Padding="5"
                         Background="#F0F2F5" BorderThickness="0" Foreground="Gray"/>
                <DatePicker Width="140" Margin="5" x:Name="FromDatePicker"/>
                <DatePicker Width="140" Margin="5" x:Name="ToDatePicker"/>
                <ComboBox Width="140" Margin="5" x:Name="StatusComboBox" Height="30">
                    <ComboBoxItem Content=""/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Accepted"/>
                    <ComboBoxItem Content="Declined"/>
                    <ComboBoxItem Content="Finished"/>
                    <ComboBoxItem Content="Cancel"/>
                    <ComboBoxItem Content="Missed"/>
                </ComboBox>
                <Button Content="Apply Filter" Width="100" Height="30" Margin="5"
                        Background="#1e68ff" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Click="ApplyFilter_Click"/>
                <Button Content="Reset" Width="80" Height="30" Margin="5"
                        Background="#fdd835" Foreground="Black" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Click="ResetFilter_Click"/>
            </StackPanel>

            <!-- DataGrid -->
            <Border Background="White" CornerRadius="10" Padding="10">
                <DataGrid x:Name="AppointmentGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          RowBackground="White"
                          AlternatingRowBackground="#f5f8fe"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          ColumnHeaderHeight="35"
                          RowHeight="40"
                          FontSize="13"
                          VerticalGridLinesBrush="#e0e0e0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1e68ff"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding AppointmentDate, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*"/>
                        <DataGridTextColumn Header="Member" Binding="{Binding Member.Username}" Width="*"/>
                        <DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>

                        <DataGridTemplateColumn Header="Note" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: actions/text -->
                                        <StackPanel Orientation="Horizontal" Margin="2" VerticalAlignment="Center" Grid.Column="0">
                                            <!-- Pending: Accept & Decline -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="✅ Accept" Margin="2" Tag="{Binding AppointmentId}"
                                                        Background="#4CAF50" Foreground="White"
                                                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                        Cursor="Hand" Padding="6,2" Click="Accept_Click"/>
                                                <Button Content="❌ Decline" Margin="2" Tag="{Binding AppointmentId}"
                                                        Background="#f44336" Foreground="White"
                                                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                        Cursor="Hand" Padding="6,2" Click="Decline_Click"/>
                                            </StackPanel>

                                            <!-- Accepted: Finish -->
                                            <Button Content="✔️ Finish" Margin="2" Tag="{Binding AppointmentId}"
                                                    Background="#1e88e5" Foreground="White"
                                                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                    Cursor="Hand" Padding="6,2" Click="Finish_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Other statuses: text -->
                                            <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="Gray" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Declined">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Declined"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Finished"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Cancelled"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Missed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Missed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Right: Save button -->
                                        <Button Grid.Column="1" Content="💾 Save" Margin="2,0,0,0" Tag="{Binding AppointmentId}"
                                                Background="#FFC107" Foreground="Black"
                                                BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                Cursor="Hand" Padding="6,2" Click="SaveNote_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
