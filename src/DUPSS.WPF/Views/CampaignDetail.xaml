<Page x:Class="DUPSS.WPF.Views.CampaignDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Campaign Detail">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#f7f9fc">
        <Border Margin="40" HorizontalAlignment="Center" Width="800" Background="White" Padding="20" CornerRadius="10">
            <StackPanel>
                <Image x:Name="CampaignImage"
                       Height="250"
                       Stretch="UniformToFill"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

                <TextBlock x:Name="TitleTextBlock"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Status: " FontWeight="SemiBold" FontSize="14" Foreground="#555"/>
                    <TextBlock x:Name="StatusTextBlock" FontSize="14" Foreground="#555"/>
                </StackPanel>

                <TextBlock Text="Location:" FontWeight="SemiBold" FontSize="16" Foreground="#2c3e50" Margin="0,10,0,2"/>
                <TextBlock x:Name="LocationTextBlock" FontSize="14" Foreground="#555" TextWrapping="Wrap"/>

                <TextBlock Text="Introduction:" FontWeight="SemiBold" FontSize="16" Foreground="#2c3e50" Margin="0,10,0,2"/>
                <TextBlock x:Name="IntroductionTextBlock" FontSize="14" Foreground="#555" TextWrapping="Wrap"/>

                <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="16" Foreground="#2c3e50" Margin="0,10,0,2"/>
                <TextBlock x:Name="DescriptionTextBlock" FontSize="14" Foreground="#555" TextWrapping="Wrap"/>

                <Button Content="Register"
                        Click="RegisterButton_Click"
                        Background="#1e68ff"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Padding="8,4"
                        BorderThickness="0"
                        Margin="0,20,0,0"
                        Width="150"
                        Height="40"
                        HorizontalAlignment="Center"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1554c0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#e0e0e0"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
