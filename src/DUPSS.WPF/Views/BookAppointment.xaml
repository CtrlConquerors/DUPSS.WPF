<Page x:Class="DUPSS.WPF.Views.BookAppointment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Book Appointment"
      Background="#F0F4FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Width="700" Height="500">
        <Grid Margin="20">
            <Border Padding="30" Background="White" CornerRadius="16"
                    BorderBrush="#2d5fa4" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="🎨 Book an Appointment"
                               FontSize="26" FontWeight="Bold" Foreground="#2d5fa4"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Warning -->
                    <TextBlock x:Name="WarningText"
                               Text="⚠️ You already have active appointment(s). Please cancel or finish them before booking new."
                               Foreground="#b45309" FontWeight="Bold"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- Date -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="📅 Choose date" FontWeight="SemiBold" Foreground="#2d5fa4" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DateComboBox" Height="32" Background="#F0F2F5" BorderThickness="0" Padding="6"
                                  SelectionChanged="DateComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Time Slot -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="🕒 Choose time slot" FontWeight="SemiBold" Foreground="#2d5fa4" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SlotComboBox" Height="32" Background="#F0F2F5" BorderThickness="0" Padding="6"/>
                    </StackPanel>

                    <!-- Topic -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="💡 Topic (What would you like to discuss?)" FontWeight="SemiBold" Foreground="#2d5fa4" Margin="0,0,0,4"/>
                        <TextBox x:Name="TopicTextBox" Height="70" Background="#F0F2F5" BorderThickness="0" TextWrapping="Wrap" Padding="6"/>
                    </StackPanel>

                    <!-- Button -->
                    <Button Content="🖌️ Book Now"
                            Background="#2d5fa4" Foreground="White"
                            FontWeight="SemiBold"
                            Padding="10"
                            Width="140" Height="36"
                            HorizontalAlignment="Center" Cursor="Hand"
                            Click="BookNow_Click"
                            Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
