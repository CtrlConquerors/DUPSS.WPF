<Page x:Class="DUPSS.WPF.Views.CourseDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DUPSS.WPF"
  
      xmlns:dtos="clr-namespace:DUPSS.DTO.DTOs;assembly=DUPSS.DTO"
      mc:Ignorable="d"
      d:DesignHeight="1020" d:DesignWidth="1280"
      Title="CourseDetailPage"
      Loaded="Page_Loaded" >

    <Page.Resources>
        <!-- Colors and Brushes (from CourseDetailPage.razor.css) -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#007bff"/>
        <SolidColorBrush x:Key="LightBlue" Color="#7fbcff"/>
        <SolidColorBrush x:Key="DarkText" Color="#1a2233"/>
        <SolidColorBrush x:Key="MediumText" Color="#3b4252"/>
        <SolidColorBrush x:Key="LightGrayBg" Color="#f7f7fa"/>
        <SolidColorBrush x:Key="GreenIndicator" Color="#28a745"/>
        <SolidColorBrush x:Key="GreyIndicator" Color="#6c757d"/>
        <SolidColorBrush x:Key="BlueIndicator" Color="#007bff"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#155724"/>
        <SolidColorBrush x:Key="SuccessBg" Color="#d4edda"/>
        <SolidColorBrush x:Key="SuccessBorder" Color="#c3e6cb"/>
        <SolidColorBrush x:Key="DangerColor" Color="#721c24"/>
        <SolidColorBrush x:Key="DangerBg" Color="#f8d7da"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#f5c6cb"/>
        <SolidColorBrush x:Key="WarningColor" Color="#856404"/>
        <SolidColorBrush x:Key="WarningBg" Color="#fff3cd"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#ffeeba"/>
        <SolidColorBrush x:Key="InfoColor" Color="#0c5460"/>
        <SolidColorBrush x:Key="InfoBg" Color="#d1ecf1"/>
        <SolidColorBrush x:Key="InfoBorder" Color="#bee5eb"/>
        <SolidColorBrush x:Key="WhiteTransparent65" Color="#FFFFFF" Opacity="0.65"/>
        <SolidColorBrush x:Key="WhiteTransparent32" Color="#FFFFFF" Opacity="0.32"/>
        <SolidColorBrush x:Key="BlueTransparent18" Color="#1F2687" Opacity="0.18"/>
        <SolidColorBrush x:Key="BlueTransparent22" Color="#007bff" Opacity="0.22"/>
        <SolidColorBrush x:Key="LightBlueTransparent18" Color="#7fbcff" Opacity="0.18"/>
        <SolidColorBrush x:Key="LightBlueTransparent22" Color="#7fbcff" Opacity="0.22"/>
        <SolidColorBrush x:Key="GreenTransparent30" Color="#28a745" Opacity="0.30"/>

        <!-- Styles for TextBlocks -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
        </Style>

        <Style x:Key="CourseDetailTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="0 0 0 16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
        </Style>

        <!-- CourseDetailSubtitleStyle: Removed Template, apply Border properties directly in XAML -->
        <Style x:Key="CourseDetailSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource MediumText}"/>
            <Setter Property="Margin" Value="0 0 0 32"/>
            <Setter Property="LineHeight" Value="28.8"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CourseTopicBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#e9f2ff"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8 15"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Removed Setter Property="Child" as it cannot be set in a Style -->
        </Style>

        <Style x:Key="CourseTypeDisplayStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <!-- Removed Setter Property="Padding" as StackPanel does not support it directly -->
            <Setter Property="Background" Value="Transparent"/>
            <!-- Removed Setter Property="CornerRadius" as StackPanel does not support it directly -->
            <Setter Property="TextElement.FontSize" Value="14"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>

        <!-- CourseInventoryStyle: Removed Template, apply Border properties directly in XAML -->
        <Style x:Key="CourseInventoryStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- InstructorInfoStyle: Removed visual properties to be applied to a wrapping Border -->
        <Style x:Key="InstructorInfoStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 36"/>
        </Style>

        <!-- InstructorAvatarSmallStyle: Removed Template. Image will be wrapped in Border in XAML. -->
        <Style x:Key="InstructorAvatarSmallStyle" TargetType="Image">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Stretch" Value="UniformToFill"/>
            <Setter Property="Margin" Value="0 0 14 0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Clip">
                <Setter.Value>
                    <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="0" Color="Transparent"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnrollButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#007bff" Offset="0.0"/>
                        <GradientStop Color="#7fbcff" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Padding" Value="18 44"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18.88"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="0 0 0 32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="6" Color="#007bff" Opacity="0.18" BlurRadius="32"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="100"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#52FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#387fbcff" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="12" Color="#1F2687" Opacity="0.22" BlurRadius="48"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#cccccc"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="BorderBrush" Value="#aaaaaa"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="RenderTransform" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GoToCourseButtonStyle" TargetType="Button" BasedOn="{StaticResource EnrollButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#28a745" Offset="0.0"/>
                        <GradientStop Color="#34d058" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GreenIndicator}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="6" Color="#28a745" Opacity="0.3" BlurRadius="32"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#218838" Offset="0.0"/>
                                <GradientStop Color="#2fb74d" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#218838"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="12" Color="#28a745" Opacity="0.4" BlurRadius="48"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoadingIndicatorStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="50"/>
            <Setter Property="Background" Value="{StaticResource WhiteTransparent65}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="4" Color="#000000" Opacity="0.05" BlurRadius="20"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource WhiteTransparent32}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ErrorMessageStyle" TargetType="Border" BasedOn="{StaticResource LoadingIndicatorStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NoCourseMessageStyle" TargetType="Border" BasedOn="{StaticResource LoadingIndicatorStyle}">
            <Setter Property="Background" Value="#e9ecf1"/>
            <Setter Property="BorderBrush" Value="#ced4da"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- EnrollmentMessageStyle: Removed Template. Will apply Border properties directly in XAML. -->
        <Style x:Key="EnrollmentMessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0 15 0 0"/>
            <!-- DataTriggers will now apply to the wrapping Border's properties -->
            <!-- The TextBlock itself will only get Foreground from these triggers if applied to the Border -->
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="29.6"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Margin" Value="0 0 0 22"/>
            <!-- Removed Padding, BorderThickness, and BorderBrush as they are not TextBlock properties -->
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InstructorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WhiteTransparent65}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="4" Color="#007bff" Opacity="0.10" BlurRadius="24"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0 28 0 0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BlueTransparent18}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- InstructorAvatarLargeStyle: Removed Template. Image will be wrapped in Border in XAML. -->
        <Style x:Key="InstructorAvatarLargeStyle" TargetType="Image">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="Stretch" Value="UniformToFill"/>
            <Setter Property="Margin" Value="0 0 32 0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Clip">
                <Setter.Value>
                    <EllipseGeometry Center="64,64" RadiusX="64" RadiusY="64"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstructorNameBigStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24.8"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InstructorTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17.92"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InstructorDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17.28"/>
            <Setter Property="Foreground" Value="#4b5563"/>
            <Setter Property="LineHeight" Value="29.376"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Style for the main CourseLayoutGrid Border -->
        <Style x:Key="CourseLayoutGridStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WhiteTransparent65}"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="12" Color="#1F2687" Opacity="0.18" BlurRadius="48"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="56 48"/>
            <Setter Property="BorderBrush" Value="{StaticResource WhiteTransparent32}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MaxWidth" Value="1200"/>
            <Setter Property="Width" Value="Auto"/>
        </Style>

        <!-- CourseDecorativeImageStyle: Removed Template. Image will be wrapped in Border in XAML. -->
        <Style x:Key="CourseDecorativeImageStyle" TargetType="Image">
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="MaxHeight" Value="440"/>
            <Setter Property="Stretch" Value="UniformToFill"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <!-- CornerRadius, Effect, BorderBrush, BorderThickness, Background will be on the wrapping Border -->
            <!-- Removed Style.Triggers as they are handled by the wrapping Border -->
        </Style>

        <!-- Define InstructorInfoEffect -->
        <DropShadowEffect x:Key="InstructorInfoEffect" ShadowDepth="4" Color="#007bff" Opacity="0.10" BlurRadius="24"/>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="167*"/>
            <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>
        <!-- Main container for the entire page -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#e0e7ff" Offset="0"/>
                <GradientStop Color="#f7f7fa" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative blurred background shapes (WPF equivalent using Ellipses) -->
        <Ellipse Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,60,0,0" Opacity="0.25">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7fbcff" Offset="0"/>
                    <GradientStop Color="#e0c3fc" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="60"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,40" Opacity="0.25" Grid.RowSpan="2">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#a1c4fd" Offset="0"/>
                    <GradientStop Color="#c2e9fb" Offset="1"/>

                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="60"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Conditional Content Display -->
        <Border x:Name="LoadingState" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Style="{StaticResource LoadingIndicatorStyle}" VerticalAlignment="Top" MaxWidth="500" Margin="0,261,0,0">
            <!-- Content for LoadingState defined directly here -->
            <StackPanel>
                <TextBlock Text="Loading course information..." FontSize="19.2" Foreground="#6c757d" HorizontalAlignment="Center"/>
                <Border Width="30" Height="30" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="15" BorderThickness="4" BorderBrush="White">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="15" CenterY="15"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#007bff" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.5"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorState" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
              Style="{StaticResource ErrorMessageStyle}" VerticalAlignment="Top" MaxWidth="500" Margin="0,257,0,0">
            <!-- Content for ErrorState defined directly here -->
            <StackPanel>
                <TextBlock Text="Oops! Something went wrong while loading the course. Please try again later." FontSize="19.2" Foreground="{StaticResource DangerColor}" HorizontalAlignment="Center"/>
                <Button Content="Back to Courses" Margin="0 20 0 0" Padding="10 20" HorizontalAlignment="Center" Command="{Binding GoBackToCoursesCommand}" />
            </StackPanel>
        </Border>

        <Border x:Name="NoCourseState" Visibility="{Binding NoCourseFound, Converter={StaticResource BooleanToVisibilityConverter}}"
              Style="{StaticResource NoCourseMessageStyle}" VerticalAlignment="Top" MaxWidth="500" Margin="0,257,0,0">
            <!-- Content for NoCourseState defined directly here -->
            <StackPanel>
                <TextBlock Text="No course found with the given ID. Please check the URL or try again." FontSize="19.2" Foreground="#6c757d" HorizontalAlignment="Center"/>
                <Button Content="Back to Courses" Margin="0 20 0 0" Padding="10 20" HorizontalAlignment="Center" Command="{Binding GoBackToCoursesCommand}" />
            </StackPanel>
        </Border>

        <!-- NEW: Wrap the CourseContentGrid in a ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-28,-21" Grid.RowSpan="2">
            <Border x:Name="CourseContentGrid" Visibility="{Binding ShowCourseContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource CourseLayoutGridStyle}" Margin="0,56,0,0" Height="904">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Course Content Column -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="6"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0 0 28 0">
                        <TextBlock Text="{Binding CourseData.Course.CourseName}" Style="{StaticResource CourseDetailTitleStyle}"/>

                        <!-- CourseDetailSubtitleStyle: Wrapped TextBlock in Border for background, padding, corner radius, and effect -->
                        <Border Background="{StaticResource WhiteTransparent65}"
                                Padding="10 18"
                                CornerRadius="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0 0 0 32">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" Color="#007bff" Opacity="0.04" BlurRadius="6"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding CourseData.Description}" Style="{StaticResource CourseDetailSubtitleStyle}"/>
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0 0 0 25">
                            <!-- CourseTopicBadgeStyle: TextBlock is now a direct child of the Border -->
                            <Border Style="{StaticResource CourseTopicBadgeStyle}" Margin="0 0 15 0">
                                <TextBlock Text="{Binding CourseData.Course.Topic.TopicName}" Foreground="{StaticResource PrimaryBlue}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Course Type Display - Content defined directly here -->
                            <StackPanel Style="{StaticResource CourseTypeDisplayStyle}" Margin="0 0 15 0">
                                <Ellipse Width="10" Height="10" Margin="0 0 5 0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="0" Color="Transparent"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CourseData.Course.CourseType}" Value="online">
                                                    <Setter Property="Fill" Value="{StaticResource GreenIndicator}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="#28a745" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CourseData.Course.CourseType}" Value="offline">
                                                    <Setter Property="Fill" Value="{StaticResource GreyIndicator}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="#808080" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CourseData.Course.CourseType}" Value="hybrid">
                                                    <Setter Property="Fill" Value="{StaticResource BlueIndicator}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="#0000FF" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CourseData.Course.CourseType}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CourseInventoryStyle: Wrapped TextBlock in Border for background, padding, corner radius -->
                            <!-- REMOVED: Inventory display -->
                            <!-- <Border Background="#f0f2f5" Padding="8 15" CornerRadius="20">
                                <TextBlock Text="{Binding CourseData.Course.Inventory, StringFormat='Inventory: {0}'}" Style="{StaticResource CourseInventoryStyle}"/>
                            </Border> -->
                        </WrapPanel>

                        <!-- Instructor Info: Wrapped StackPanel in a Border to apply visual properties -->
                        <Border Background="{StaticResource WhiteTransparent65}"
                                CornerRadius="36"
                                Padding="10 22 10 10"
                                Effect="{StaticResource InstructorInfoEffect}"
                                HorizontalAlignment="Left"
                                Margin="0 0 0 76" Width="381">
                            <StackPanel Style="{StaticResource InstructorInfoStyle}" VerticalAlignment="Top" Width="245">
                                <!-- InstructorAvatarSmallStyle: Wrapped Image in Border for border and background -->
                                <Border Width="48" Height="48" Margin="0 0 14 0"
                                        BorderBrush="#b6d0ff" BorderThickness="2.5" Background="White"
                                        CornerRadius="24">
                                    <!-- Half of Width/Height for perfect circle -->
                                    <Image Source="{Binding CourseData.Instructor.ImageUrl}" Style="{StaticResource InstructorAvatarSmallStyle}"/>
                                </Border>
                                <TextBlock Width="206" RenderTransformOrigin="0.528,0.489" Height="47">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleY="-0.171"/>
                                            <RotateTransform/>
                                            <TranslateTransform Y="0.08"/>
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                    <Run Text="Instructor: "/>
                                    <!-- MODIFIED: Changed Hyperlink to TextBlock to disable clicking -->
                                    <TextBlock Text="{Binding CourseData.Instructor.Username}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Conditional button rendering: Enroll Now or Go to Course -->
                        <Button x:Name="EnrollButton"
                                Content="{Binding EnrollButtonText}"
                                Command="{Binding EnrollCommand}"
                                IsEnabled="{Binding IsEnrollButtonEnabled}"
                                Visibility="{Binding IsEnrolledSuccessfully, Converter={StaticResource BooleanToVisibilityConverterInverted}}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EnrollButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnrolling}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="2" BorderBrush="White" Margin="0 0 50 30">
                                                            <Border.RenderTransform>
                                                                <RotateTransform CenterX="8" CenterY="8"/>
                                                            </Border.RenderTransform>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsVisible" Value="True">
                                                                            <Trigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" />
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </Trigger.EnterActions>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#007bff" Offset="0"/>
                                                                    <GradientStop Color="Transparent" Offset="0.5"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="Loading..." VerticalAlignment="Center" Foreground="White"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="GoToCourseButton"
                                Content="Go to Course"
                                Style="{StaticResource GoToCourseButtonStyle}"
                                Command="{Binding GoToCourseContentCommand}"
                                Visibility="{Binding IsEnrolledSuccessfully, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left" Width="232" Height="120"/>

                        <!-- Enrollment message display: Wrapped TextBlock in Border for background, border, padding, corner radius -->
                        <Border Padding="10 20" CornerRadius="8" HorizontalAlignment="Left" Margin="0 15 0 0"
                                Visibility="{Binding HasEnrollmentMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-success">
                                            <Setter Property="Background" Value="{StaticResource SuccessBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-danger">
                                            <Setter Property="Background" Value="{StaticResource DangerBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-warning">
                                            <Setter Property="Background" Value="{StaticResource WarningBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-info">
                                            <Setter Property="Background" Value="{StaticResource InfoBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EnrollmentMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EnrollmentMessageStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-success">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-danger">
                                                <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-warning">
                                                <Setter Property="Foreground" Value="{StaticResource WarningColor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EnrollmentMessageClass}" Value="alert-info">
                                                <Setter Property="Foreground" Value="{StaticResource InfoColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Course Image Column -->
                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="6" Margin="28 0 0 0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="400" MaxHeight="440"
                            CornerRadius="24"
                            BorderBrush="#007bff" BorderThickness="2.5"
                            Background="{StaticResource WhiteTransparent32}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.13" BlurRadius="40"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="16" Color="#007bff" Opacity="0.18" BlurRadius="64"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush" Value="{StaticResource LightBlue}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding CourseData.Course.ImageUrl}" Style="{StaticResource CourseDecorativeImageStyle}"/>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
