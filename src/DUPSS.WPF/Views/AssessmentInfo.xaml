<Page x:Class="DUPSS.WPF.Views.AssessmentInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Assessment Info"
      Loaded="Page_Loaded"
      Background="#F7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" x:Name="MainPanel">

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,0,0">
                <TextBlock Text="Loading assessment information..." FontStyle="Italic" FontSize="16" Foreground="#3554d1"/>
                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,10,0,0" Width="200"/>
            </StackPanel>

            <!-- Error -->
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#fff0f0" BorderBrush="#ffb3b3" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="Could not load assessment information. Please try again." Foreground="#d32f2f" FontWeight="Bold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
                        <Button Content="Retry" Click="Retry_Click" Margin="0,0,10,0" Padding="12,4"/>
                        <Button Content="Back to Assessments" Click="GoBack_Click" Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Not Found -->
            <Border x:Name="NotFoundPanel" Visibility="Collapsed" Background="#f5f5f5" BorderBrush="#ccc" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="Assessment not found." FontWeight="Bold" Foreground="Gray" FontSize="16"/>
                    <Button Content="Back to Assessments" Margin="0,16,0,0" Click="GoBack_Click" Padding="12,4"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <Border x:Name="ContentPanel" Visibility="Collapsed" Background="White" Padding="32" CornerRadius="16" Margin="0,40,0,0" BorderBrush="#eaf3ff" BorderThickness="1" >
                <StackPanel>
                    <!-- Title and Meta -->
                    <TextBlock x:Name="TitleTextBlock" FontSize="28" FontWeight="Bold" Foreground="#1e68ff" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18" >
                        <TextBlock x:Name="VersionTextBlock" Foreground="#555" FontSize="14" Margin="0,0,16,0"/>
                        <TextBlock x:Name="LanguageTextBlock" Foreground="#555" FontSize="14" Margin="0,0,16,0"/>
                        <TextBlock x:Name="DurationTextBlock" Foreground="#555" FontSize="14"/>
                    </StackPanel>

                    <!-- About Section -->
                    <Border Background="#eaf3ff" Padding="18" CornerRadius="10" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="22" Margin="0,0,8,0"/>
                                <TextBlock Text="About This Assessment" FontWeight="Bold" FontSize="18" Foreground="#3554d1"/>
                            </StackPanel>
                            <TextBlock x:Name="DescriptionTextBlock" FontSize="15" Foreground="#222" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel x:Name="ExtraContentPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Important Notes -->
                    <Border Background="#fffbe6" Padding="18" CornerRadius="10" Margin="0,0,0,18" BorderBrush="#ffe082" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="22" Margin="0,0,8,0"/>
                                <TextBlock Text="Important Notes" FontWeight="Bold" FontSize="18" Foreground="#d97706"/>
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="❗" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="This tool is not a diagnosis." Foreground="#d32f2f" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="💬" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock>
                                        <Run Text="If you're concerned, "/>
                                        <Hyperlink NavigateUri="https://www.who.int/" Foreground="#1e68ff">consult a professional</Hyperlink>
                                        <Run Text="."/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="🔒" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Your responses are confidential." Foreground="#388e3c" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button Content="Start Assessment" Width="160" Height="38" Click="StartAssessment_Click" Background="#1e68ff" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Back to Assessments" Width="160" Height="38" Click="GoBack_Click" Background="#eaf3ff" Foreground="#3554d1" FontWeight="Bold" BorderBrush="#3554d1" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>