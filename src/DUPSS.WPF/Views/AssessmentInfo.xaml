<Page x:Class="DUPSS.WPF.Views.AssessmentInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Assessment Info"
      Loaded="Page_Loaded"
      Background="#F7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" x:Name="MainPanel">

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                <TextBlock Text="Loading assessment information..." FontStyle="Italic"/>
                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,5"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="Could not load assessment information. Please try again." Foreground="Red"/>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Button Content="Retry" Click="Retry_Click" Margin="0,0,10,0"/>
                    <Button Content="Back to Assessments" Click="GoBack_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Not Found -->
            <StackPanel x:Name="NotFoundPanel" Visibility="Collapsed">
                <TextBlock Text="Assessment not found." FontWeight="Bold" Foreground="Gray"/>
                <Button Content="Back to Assessments" Margin="0,10,0,0" Click="GoBack_Click"/>
            </StackPanel>

            <!-- Main Content -->
            <StackPanel x:Name="ContentPanel" Visibility="Collapsed">

                <TextBlock x:Name="TitleTextBlock" FontSize="26" FontWeight="Bold" Foreground="#1e68ff"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock x:Name="VersionTextBlock" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LanguageTextBlock" Margin="0,0,10,0"/>
                    <TextBlock x:Name="DurationTextBlock"/>
                </StackPanel>

                <TextBlock Text="About This Assessment" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,5"/>
                <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Foreground="Black"/>

                <!-- Extra Sections (populated in code-behind) -->
                <StackPanel x:Name="ExtraContentPanel" Margin="0,20,0,0"/>

                <!-- Notes -->
                <TextBlock Text="Important Notes" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,10"/>
                <StackPanel>
                    <TextBlock Text="• This tool is not a diagnosis." Foreground="OrangeRed"/>
                    <TextBlock Text="• If you're concerned, consult a professional." Foreground="Blue"/>
                    <TextBlock Text="• Your responses are confidential." Foreground="Green"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button Content="Start Assessment" Click="StartAssessment_Click" Margin="0,0,10,0"/>
                    <Button Content="Back to Assessments" Click="GoBack_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
