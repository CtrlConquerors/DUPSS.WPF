<Page x:Class="DUPSS.WPF.Views.AssessmentTake"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Take Assessment"
      Background="#F7F9FC"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Primary Button Style with Hover -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1e68ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1550b8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#bfc9e6"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary Button Style with Hover -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#eaf3ff"/>
            <Setter Property="Foreground" Value="#1e68ff"/>
            <Setter Property="BorderBrush" Value="#1e68ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d0e3ff"/>
                                <Setter Property="Foreground" Value="#1550b8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f0f4fa"/>
                                <Setter Property="Foreground" Value="#aaa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Danger Button Style with Hover -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#dc3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#b52a37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f5bfc4"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Submit Button Style with Hover -->
        <Style x:Key="SubmitButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#bfe6c7"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#222"/>
        </Style>
        <!-- TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading Indicator -->
        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="120" Height="5" Foreground="#1e68ff"/>
            <TextBlock Text="Loading assessment..." FontStyle="Italic" Margin="0,12,0,0" FontSize="16" Foreground="#3554d1"/>
        </StackPanel>

        <!-- Error Message -->
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#fff0f0" BorderBrush="#ffb3b3" BorderThickness="1" CornerRadius="10" Padding="28" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center"/>
                <TextBlock Text="Unable to Load Assessment" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorMessage" Foreground="#d32f2f" HorizontalAlignment="Center" FontSize="15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="🔄 Retry" Click="RetryLoadAssessment_Click"/>
                    <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- No Content Message -->
        <Border x:Name="NoContentPanel" Visibility="Collapsed" Background="#f5f5f5" BorderBrush="#ccc" BorderThickness="1" CornerRadius="10" Padding="28" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center"/>
                <TextBlock Text="Assessment Not Available" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="This assessment is currently not available or has no questions." HorizontalAlignment="Center" FontSize="15"/>
                <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- Results View -->
        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="0,40,0,0" HorizontalAlignment="Center" Width="520">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="✅" FontSize="28"/>
                <TextBlock Text="Assessment Complete" FontSize="26" FontWeight="Bold" Margin="12,0"/>
            </StackPanel>
            <TextBlock x:Name="ResultsHeader" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Margin="0,24">
                <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#eaf3ff" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Score: " FontWeight="Bold"/>
                            <TextBlock x:Name="TotalScore" />
                        </StackPanel>
                        <TextBlock Text="Recommendations" FontWeight="Bold" Margin="0,12,0,5"/>
                        <TextBlock x:Name="Recommendation"/>
                        <TextBlock Text="Score Details" FontWeight="Bold" Margin="0,12,0,5"/>
                        <ItemsControl x:Name="ScoreDetails">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Completed on: " FontWeight="Bold"/>
                            <TextBlock x:Name="CompletedOn"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="📋 Take Another Assessment" Click="TakeAnotherAssessment_Click"/>
                    <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Assessment View -->
        <StackPanel x:Name="AssessmentPanel" Visibility="Collapsed" Margin="0,40,0,0" HorizontalAlignment="Center" Width="520">
            <StackPanel x:Name="AssessmentHeader">
                <TextBlock x:Name="AssessmentType" FontSize="26" FontWeight="Bold" Foreground="#1e68ff"/>
                <TextBlock x:Name="AssessmentDescription" Foreground="Gray" FontSize="15"/>
                <TextBlock x:Name="SubstanceInfo" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="ProgressText" FontWeight="Bold"/>
                    <TextBlock x:Name="ProgressPercentage" Margin="10,0,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,5,0,0" Foreground="#1e68ff"/>
            </StackPanel>

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,24,0,0" BorderBrush="#eaf3ff" BorderThickness="1">
                <StackPanel x:Name="QuestionCard">
                    <TextBlock x:Name="QuestionHeader" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="QuestionText" FontSize="16" Margin="0,10,0,10"/>
                    <StackPanel x:Name="AnswersContainer"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="PreviousButton" Content="← Previous" Style="{StaticResource SecondaryButton}" Click="PreviousQuestion_Click"/>
                        <Button x:Name="NextButton" Content="Next →" Click="NextQuestion_Click"/>
                        <Button x:Name="SubmitButton" Content="✓ Submit Assessment" Style="{StaticResource SubmitButton}" Click="SubmitAssessment_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="× Exit Assessment" Style="{StaticResource DangerButton}" Click="ConfirmExit_Click" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Exit Confirmation Modal -->
        <Grid x:Name="ExitConfirmationPanel" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Padding="28" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Exit Assessment?" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Are you sure you want to exit this assessment? Your progress will be lost." Margin="0,12,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelExit_Click"/>
                        <Button Content="Exit" Style="{StaticResource DangerButton}" Click="ExitAssessment_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>