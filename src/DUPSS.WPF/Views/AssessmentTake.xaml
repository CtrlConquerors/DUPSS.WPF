<Page x:Class="DUPSS.WPF.Views.AssessmentTake"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Take Assessment"
      Background="#F7F9FC"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#1e68ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" Margin="5,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6c757d"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="SubmitButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading Indicator -->
        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
            <TextBlock Text="Loading assessment..." FontStyle="Italic" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Error Message -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="Unable to Load Assessment" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorMessage" Foreground="Red" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="🔄 Retry" Click="RetryLoadAssessment_Click"/>
                <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- No Content Message -->
        <StackPanel x:Name="NoContentPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="Assessment Not Available" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="This assessment is currently not available or has no questions." HorizontalAlignment="Center"/>
            <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Results View -->
        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="✅" FontSize="24"/>
                <TextBlock Text="Assessment Complete" FontSize="24" FontWeight="Bold" Margin="10,0"/>
            </StackPanel>
            <TextBlock x:Name="ResultsHeader" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Margin="0,20">
                <Border Background="White" CornerRadius="10" Padding="15" BorderBrush="#ccc" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Score: " FontWeight="Bold"/>
                            <TextBlock x:Name="TotalScore" />
                        </StackPanel>
                        <TextBlock Text="Recommendations" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock x:Name="Recommendation"/>
                        <TextBlock Text="Score Details" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ItemsControl x:Name="ScoreDetails">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Completed on: " FontWeight="Bold"/>
                            <TextBlock x:Name="CompletedOn"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="📋 Take Another Assessment" Click="TakeAnotherAssessment_Click"/>
                    <Button Content="← Back to Assessments" Style="{StaticResource SecondaryButton}" Click="GoBackToAssessments_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Assessment View -->
        <StackPanel x:Name="AssessmentPanel" Visibility="Collapsed">
            <StackPanel x:Name="AssessmentHeader">
                <TextBlock x:Name="AssessmentType" FontSize="24" FontWeight="Bold" Foreground="#1e68ff"/>
                <TextBlock x:Name="AssessmentDescription" Foreground="Gray"/>
                <TextBlock x:Name="SubstanceInfo" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="ProgressText" FontWeight="Bold"/>
                    <TextBlock x:Name="ProgressPercentage" Margin="10,0,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,20,0,0" BorderBrush="#ccc" BorderThickness="1">
                <StackPanel x:Name="QuestionCard">
                    <TextBlock x:Name="QuestionHeader" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="QuestionText" FontSize="16" Margin="0,10,0,10"/>
                    <StackPanel x:Name="AnswersContainer"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="PreviousButton" Content="← Previous" Style="{StaticResource SecondaryButton}" Click="PreviousQuestion_Click"/>
                        <Button x:Name="NextButton" Content="Next →" Click="NextQuestion_Click"/>
                        <Button x:Name="SubmitButton" Content="✓ Submit Assessment" Style="{StaticResource SubmitButton}" Click="SubmitAssessment_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="× Exit Assessment" Style="{StaticResource DangerButton}" Click="ConfirmExit_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Exit Confirmation Modal -->
        <Grid x:Name="ExitConfirmationPanel" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Exit Assessment?" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Are you sure you want to exit this assessment? Your progress will be lost." Margin="0,10,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelExit_Click"/>
                        <Button Content="Exit" Style="{StaticResource DangerButton}" Click="ExitAssessment_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>