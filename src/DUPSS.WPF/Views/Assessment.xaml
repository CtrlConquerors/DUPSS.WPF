<Page x:Class="DUPSS.WPF.Views.Assessment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      xmlns:dtOs="clr-namespace:DUPSS.DTO.DTOs;assembly=DUPSS.DTO"
      Title="Assessments"
      Background="#F7F9FC"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" x:Name="MainPanel" Background="#F7F9FC">

            <!-- Header -->
            <TextBlock Text="Mental Health &amp; Substance Use Assessments"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1e68ff"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Complete validated screening tools to assess your mental health and substance use patterns. These assessments provide insights and recommendations for your wellbeing."
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

            <!-- Error or Loading -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="Oops! Something went wrong while loading assessments. Please try again later."
                           Foreground="Red" FontWeight="SemiBold"/>
                <Button Content="Retry" Margin="0,10,0,0" Width="100" Click="RetryButton_Click"/>
            </StackPanel>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                <TextBlock Text="Loading assessments..." FontStyle="Italic"/>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- No Data -->
            <StackPanel x:Name="NoDataPanel" Visibility="Collapsed">
                <TextBlock Text="No assessments available at the moment. Please check back later!" Foreground="DarkGray"/>
            </StackPanel>

            <!-- Assessments List -->
            <ItemsControl x:Name="AssessmentList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dtOs:AssessmentDTO}">
                        <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10" BorderBrush="#ccc" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding AssessmentType}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Version}" Foreground="Gray"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button Content="Take Assessment" Margin="0,0,10,0" Click="TakeAssessment_Click" Tag="{Binding AssessmentId}"/>
                                    <Button Content="Learn More" Click="LearnMore_Click" Tag="{Binding AssessmentId}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Show More / Less -->
            <StackPanel x:Name="ShowMorePanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Button x:Name="ToggleShowButton" Content="Show More Assessments" Click="ToggleShowButton_Click" Width="200"/>
            </StackPanel>

            <!-- Info Section -->
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="About These Assessments" FontSize="20" FontWeight="Bold" Foreground="#1e68ff" Margin="0,0,0,10"/>
                <WrapPanel>
                    <StackPanel Width="250" Margin="0,0,20,20">
                        <TextBlock Text="CRAFFT Screening" FontWeight="Bold" />
                        <TextBlock Text="A validated tool for screening adolescents and young adults for substance use disorders. Takes about 2-3 minutes." TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="250" Margin="0,0,20,20">
                        <TextBlock Text="ASSIST Screening" FontWeight="Bold" />
                        <TextBlock Text="WHO's Alcohol, Smoking and Substance Involvement Screening Test. Comprehensive assessment taking 5-10 minutes." TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="250">
                        <TextBlock Text="Privacy &amp; Confidentiality" FontWeight="Bold" />
                        <TextBlock Text="Your responses are confidential and used only to provide personalized recommendations for your wellbeing." TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
