<Page x:Class="DUPSS.WPF.Views.Assessment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DUPSS.WPF.Views"
      xmlns:dtOs="clr-namespace:DUPSS.DTO.DTOs;assembly=DUPSS.DTO"
      Title="Assessments"
      Background="#F7F9FC"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Primary Button Style with Hover -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1e68ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1550b8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#bfc9e6"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary Button Style with Hover -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#eaf3ff"/>
            <Setter Property="Foreground" Value="#1e68ff"/>
            <Setter Property="BorderBrush" Value="#1e68ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d0e3ff"/>
                                <Setter Property="Foreground" Value="#1550b8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f0f4fa"/>
                                <Setter Property="Foreground" Value="#aaa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Danger Button Style with Hover -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#dc3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#b52a37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#f5bfc4"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0" x:Name="MainPanel" Background="#F7F9FC" HorizontalAlignment="Center" Width="700">
            <!-- Header -->
            <TextBlock Text="Mental Health &amp; Substance Use Assessments"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1e68ff"
                       Margin="0,30,0,10"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Complete validated screening tools to assess your mental health and substance use patterns. These assessments provide insights and recommendations for your wellbeing."
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,0,0,24"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <!-- Error or Loading -->
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#fff0f0" BorderBrush="#ffb3b3" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Oops! Something went wrong while loading assessments. Please try again later."
                               Foreground="#d32f2f" FontWeight="SemiBold" FontSize="15"/>
                    <Button Content="Retry" Margin="0,10,0,0" Width="120" Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
            <Border x:Name="LoadingPanel" Visibility="Collapsed" Background="#f5f8ff" BorderBrush="#b3d1ff" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Loading assessments..." FontStyle="Italic" FontSize="15"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Foreground="#1e68ff"/>
                </StackPanel>
            </Border>
            <!-- No Data -->
            <Border x:Name="NoDataPanel" Visibility="Collapsed" Background="#f5f5f5" BorderBrush="#ccc" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <TextBlock Text="No assessments available at the moment. Please check back later!" Foreground="DarkGray" FontSize="15"/>
            </Border>

            <!-- Assessments List -->
            <ItemsControl x:Name="AssessmentList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dtOs:AssessmentDTO}">
                        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14" BorderBrush="#eaf3ff" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding AssessmentType}" FontWeight="Bold" FontSize="18" Foreground="#1e68ff"/>
                                <TextBlock Text="{Binding Version}" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                                    <Button Content="Take Assessment" Margin="0,0,10,0" Click="TakeAssessment_Click" Tag="{Binding AssessmentId}"/>
                                    <Button Content="Learn More" Style="{StaticResource SecondaryButton}" Click="LearnMore_Click" Tag="{Binding AssessmentId}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Show More / Less -->
            <StackPanel x:Name="ShowMorePanel" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="ToggleShowButton" Content="Show More Assessments" Click="ToggleShowButton_Click" Width="220"/>
            </StackPanel>

            <!-- Info Section -->
            <StackPanel Margin="0,40,0,0">
                <TextBlock Text="About These Assessments" FontSize="20" FontWeight="Bold" Foreground="#1e68ff" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,20,20" BorderBrush="#eaf3ff" BorderThickness="1" Width="220">
                        <StackPanel>
                            <TextBlock Text="CRAFFT Screening" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="A validated tool for screening adolescents and young adults for substance use disorders. Takes about 2-3 minutes." TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,20,20" BorderBrush="#eaf3ff" BorderThickness="1" Width="220">
                        <StackPanel>
                            <TextBlock Text="ASSIST Screening" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="WHO's Alcohol, Smoking and Substance Involvement Screening Test. Comprehensive assessment taking 5-10 minutes." TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20" BorderBrush="#eaf3ff" BorderThickness="1" Width="220">
                        <StackPanel>
                            <TextBlock Text="Privacy &amp; Confidentiality" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="Your responses are confidential and used only to provide personalized recommendations for your wellbeing." TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>