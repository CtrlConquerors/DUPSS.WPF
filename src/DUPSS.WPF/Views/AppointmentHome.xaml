<Page x:Class="DUPSS.WPF.Views.AppointmentHome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Appointment Home"
      Background="#F0F4FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="20" Background="White" Margin="20" MaxWidth="850" HorizontalAlignment="Center" CornerRadius="10" >
            <StackPanel>
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Welcome to the Appointment Center" FontSize="28" FontWeight="Bold" 
                               Foreground="#3554d1" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Book confidential 1-on-1 online sessions with our professional consultants"
                               FontSize="16" Foreground="#3554d1" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- About this feature -->
                <GroupBox Header="💡 About this feature" Margin="0,0,0,15" FontWeight="Bold" Foreground="#3554d1">
                    <StackPanel Margin="10,5">
                        <TextBlock TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,8">
                            This feature lets you schedule private online consultation sessions.
                            Each session lasts about 40 minutes. You can:
                        </TextBlock>
                        <TextBlock Text="🔍 Choose a consultant manually based on your preference" Margin="10,0"/>
                        <TextBlock Text="🤖 Let the system auto-assign the most suitable consultant who is available at your chosen time" Margin="10,0"/>
                        <TextBlock Text="Before confirming, describe your topic so consultants can prepare better." Margin="10,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Important Booking Rules -->
                <GroupBox Header="📌 Important Booking Rules" Margin="0,0,0,15" FontWeight="Bold" Foreground="#3554d1">
                    <StackPanel Margin="10,5">
                        <TextBlock Text="✅ You can have up to 1 active appointment (Pending or Accepted) at a time" Margin="10,2"/>
                        <TextBlock Text="⏰ You can cancel or reschedule at least 4 hours before the scheduled time" Margin="10,2"/>
                        <TextBlock Text="⚠️ Each time slot is exclusive: once someone books it, others can't book the same time" Margin="10,2"/>
                        <TextBlock Text="These rules help ensure fairness and availability for everyone." Margin="10,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Typical Consultant Availability -->
                <GroupBox Header="🕐 Typical Consultant Availability" Margin="0,0,0,15" FontWeight="Bold" Foreground="#3554d1">
                    <StackPanel Margin="10,5">
                        <TextBlock Text="Our consultants typically offer appointments during these periods:" Margin="0,0,0,8"/>
                        <TextBlock Text="Weekdays (Monday to Friday):" FontWeight="Bold" Margin="10,0"/>
                        <TextBlock Text="Evening: 17:30 – 21:30" Margin="20,0"/>
                        <TextBlock Text="Weekends (Saturday &amp; Sunday):" FontWeight="Bold" Margin="10,10,0,0"/>
                        <TextBlock Text="Morning: 09:00 – 11:30" Margin="20,0"/>
                        <TextBlock Text="Evening: 17:30 – 21:30" Margin="20,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Popular Consultation Topics -->
                <GroupBox Header="🧠 Popular Consultation Topics" Margin="0,0,0,20" FontWeight="Bold" Foreground="#3554d1">
                    <StackPanel Margin="10,5">
                        <TextBlock Text="🚭 Drug Use Prevention &amp; Awareness" Margin="10,2"/>
                        <TextBlock Text="💬 Stress &amp; Mental Health Support" Margin="10,2"/>
                        <TextBlock Text="🏫 School or Study Challenges" Margin="10,2"/>
                        <TextBlock Text="👥 Peer Relationships &amp; Social Skills" Margin="10,2"/>
                        <TextBlock Text="🏠 Family Communication" Margin="10,2"/>
                    </StackPanel>
                </GroupBox>

                <!-- Consultants List -->
                <GroupBox Header="👨‍⚕️ Meet Our Consultants" FontWeight="Bold" Foreground="#3554d1">
                    <ItemsControl x:Name="ConsultantsListBox" Margin="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f5f8ff" Padding="10" Margin="5" CornerRadius="8" BorderBrush="#3554d122" BorderThickness="1" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="16" Foreground="#3554d1"/>
                                        <TextBlock>
                            <Run Text="Email: "/><Run Text="{Binding Email}"/>
                                        </TextBlock>
                                        <TextBlock>
                            <Run Text="Phone: "/><Run Text="{Binding PhoneNumber}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>


                <!-- Footer buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" >
                    <Button Content="📖 View Your Appointment History" Width="200" Margin="10,0" Click="ViewHistory_Click"/>
                    <Button Content="📌 Book an Appointment Now" Width="200" Margin="10,0" Background="#22c55e" Foreground="White" Click="BookAppointment_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
