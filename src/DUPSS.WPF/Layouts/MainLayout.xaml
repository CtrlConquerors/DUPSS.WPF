<Window x:Class="DUPSS.WPF.Layouts.MainLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DUPSS.WPF.Layouts"
        mc:Ignorable="d"
        Title="DUPSS Application" Height="720" Width="1200"
        MinWidth="1000"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Global Brushes (ensure WindowBackgroundBrush is defined only once) -->
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#1e68ff"/>
        <SolidColorBrush x:Key="SecondaryBlueBrush" Color="#7fbcff"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="#fdd835"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#1a237e"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#f0f2f5"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="BlackBrush" Color="Black"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#555"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#f0f2f5"/>

        <Style TargetType="TextBlock" x:Key="BaseTextStyle">
            <Setter Property="FontFamily" Value="Open Sans"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="LineHeight" Value="1.6"/>
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}" x:Key="HeadingTextStyle">
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10 15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#2a0a37" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#2a0a37" Opacity="1.0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar (Collapsible) -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Padding="0"
                BorderBrush="#d6d5d5" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF052767" Offset="0"/>
                    <GradientStop Color="#3a0647" Offset="0.7"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <!-- Collapse Button -->
                <Button x:Name="SidebarToggleButton"
        Content="⮜"
        Width="36"
        Height="36"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="SidebarToggleButton_Click"
        ToolTip="Collapse/Expand Sidebar"
        FontSize="18"
        FontWeight="Bold"
        Background="#fff"
        Foreground="#1a237e"
        BorderBrush="#e0e0e0"
        BorderThickness="1"
        Cursor="Hand"
        Margin="0,8,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18"
                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#fdd835"/>
                                    <Setter Property="Foreground" Value="#1a237e"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#fbc02d"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#ffe082"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#fbc02d"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#eee"/>
                                    <Setter Property="Foreground" Value="#aaa"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel x:Name="SidebarContentPanel">
                    <!-- Application Logo/Title -->
                    <TextBlock Text="DUPSS"
                               Style="{StaticResource HeadingTextStyle}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0 20 0 40"/>
                    <!-- Navigation Menu -->
                    <Button Content="Home" Style="{StaticResource NavButtonStyle}" Tag="Home" Click="Navigate_Click"/>
                    <Button Content="About Us" Style="{StaticResource NavButtonStyle}" Tag="AboutUs" Click="Navigate_Click"/>
                    <Button x:Name="BtnAppointmentHome" Content="Appointments" 
        Style="{StaticResource NavButtonStyle}" Tag="AppointmentHome" Click="Navigate_Click"/>
                    <Button x:Name="BtnAppointmentConsultant" Content="Appointment" 
        Style="{StaticResource NavButtonStyle}" Tag="ConsultantDashboard" Click="Navigate_Click"/>

                    <Button Content="Campaign" Style="{StaticResource NavButtonStyle}" Tag="Campaign" Click="Navigate_Click"/>
                    <Button Content="Courses" Style="{StaticResource NavButtonStyle}" Tag="Courses" Click="Navigate_Click"/>
                    <Button Content="Assessments" Style="{StaticResource NavButtonStyle}" Tag="Assessments" Click="Navigate_Click"/>
                    <Button Content="Blog" Style="{StaticResource NavButtonStyle}" Tag="Blog" Click="Navigate_Click"/>
                    
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Top Row (Column 1, Row 0) -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="#f7f7f7"
                BorderBrush="#d6d5d5" BorderThickness="0,0,0,1"
                Padding="10 20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="WelcomeTextBlock" Text="Welcome, User!" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource DarkBlueBrush}" Margin="0 0 20 0" FontWeight="SemiBold" Visibility="Collapsed"/>
                <Button x:Name="LoginButton" Content="Login" Width="100" Height="35" FontSize="14" Padding="0" Click="LoginButton_Click" Visibility="Visible"/>
                <Button x:Name="LogoutButton" Content="Logout" Width="100" Height="35" FontSize="14" Padding="0" Click="Logout_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area (Column 1, Row 1) -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}" Padding="20">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
