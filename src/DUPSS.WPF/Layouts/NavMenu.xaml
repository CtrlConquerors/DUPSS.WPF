<UserControl x:Class="DUPSS.WPF.Layouts.NavMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="200">

    <Border Background="{StaticResource PrimaryBlueBrush}" Width="200">
        <StackPanel>
            <!-- Logo/Header -->
            <TextBlock Text="DUPSS"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="20 20 20 30"
                       HorizontalAlignment="Center"/>

            <!-- Navigation Menu -->
            <ListBox Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     SelectionMode="Single">

                <!-- Dashboard -->
                <ListBoxItem Cursor="Hand" Padding="12 8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10,20 L30,20 L30,30 L10,30 Z" Fill="White" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Courses -->
                <ListBoxItem Cursor="Hand" Padding="12 8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2 L2,7 L12,12 L22,7 Z" Fill="White" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Courses"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Settings -->
                <ListBoxItem Cursor="Hand" Padding="12 8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10,10 L20,10 L20,20 L10,20 Z" Fill="White" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
