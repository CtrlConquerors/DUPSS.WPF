<Application x:Class="DUPSS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Layouts/MainLayout.xaml">
    <Application.Resources>

        <!-- Global Brushes -->
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#007bff"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#f0f2f5"/>


        <!-- Global Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Merged Styles -->
        <ResourceDictionary x:Key="MergedStyles">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>



        </ResourceDictionary>
        
    </Application.Resources>
</Application>