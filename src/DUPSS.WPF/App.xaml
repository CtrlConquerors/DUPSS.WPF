<Application x:Class="DUPSS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DUPSS.WPF"
             StartupUri="Layouts/MainLayout.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global Brushes -->
            <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#007bff"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#f0f2f5"/>

            <!-- Global Converters -->
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:BooleanToVisibilityConverterInverted x:Key="BooleanToVisibilityConverterInverted"/>
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <local:HalfWidthConverter x:Key="HalfWidthConverter"/>

            <!-- Merged Styles -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
